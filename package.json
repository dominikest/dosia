{
  "name": "dosia",
  "version": "1.6.5",
  "dosia": {
    "privacyUrl": "https://dosia24.de/datenschutz-app.php",
    "updateUrl": "https://dosia24.de/version.php"
  },
  "private": true,
  "description": "Dosia – persönliche Medikamentenverwaltung (offline, lokal). Eigene App, kein Server, keine Cloud.",
  "scripts": {
    "version:write": "node scripts/write-version.mjs",
    "sync": "node scripts/write-version.mjs && cap sync android",
    "copy": "node scripts/write-version.mjs && cap copy android",
    "icons": "npx --yes @capacitor/assets@3.0.5 generate --android",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
