<?xml version="1.0" encoding="utf-8"?>
<!-- Kleinstes Widget (1x1): Dosia-Symbol, darunter das Medikament der nächsten offenen Einnahme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/compact_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/dosia_symbol" />

    <!-- Abgehakt: heller Schleier über dem Symbol -->
    <View
        android:id="@+id/compact_done"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8CFFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/compact_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:background="@drawable/dosia_widget_label"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="52dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textColor="#0D5C49"
        android:textSize="10sp"
        android:textStyle="bold" />

</FrameLayout>
